{
  "name": "opsgate",
  "version": "2.0.0",
  "description": "opsgate — AI Agent 增强的 DevOps 中台(SSH MCP + Web UI + REST API + RBAC + 审计 + Docker)",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liuzkang6/opsgate.git"
  },
  "bugs": {
    "url": "https://github.com/liuzkang6/opsgate/issues"
  },
  "homepage": "https://github.com/liuzkang6/opsgate#readme",
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "opsgate": "./packages/cli/dist/index.js"
  },
  "scripts": {
    "test": "node scripts/run-tests.js",
    "test:watch": "node --test --watch test/**/*.test.js",
    "build": "node scripts/build.js",
    "build:server": "npm run build -w @opsgate/server",
    "build:cli": "npm run build -w @opsgate/cli",
    "build:web": "npm run build -w @opsgate/web",
    "dev:server": "npm run dev -w @opsgate/server",
    "dev:web": "npm run dev -w @opsgate/web",
    "start": "node packages/server/dist/index.js --enable-web",
    "opsgate": "node packages/cli/dist/index.js",
    "prepublishOnly": "npm run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import tsx/esm packages/server/src/db/migrate.ts",
    "db:seed": "node --import tsx/esm scripts/seed.ts"
  },
  "keywords": [
    "opsgate",
    "ssh",
    "mcp",
    "server",
    "cli",
    "devops",
    "ai-agent",
    "monorepo",
    "rbac",
    "audit"
  ],
  "author": "liuzkang6",
  "license": "ISC",
  "devDependencies": {
    "drizzle-kit": "^0.30.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.2"
  },
  "files": [
    "packages/server/dist/**/*",
    "packages/cli/dist/**/*",
    "web-dist/**/*"
  ]
}
