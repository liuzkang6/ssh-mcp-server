{
  "name": "@fangjunjie/ssh-mcp-server",
  "version": "1.8.3",
  "description": "SSH-based MCP Server monorepo (基于 SSH 的 MCP 服务器 monorepo)",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/classfang/ssh-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/classfang/ssh-mcp-server/issues"
  },
  "homepage": "https://github.com/classfang/ssh-mcp-server#readme",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node scripts/run-tests.js",
    "test:watch": "node --test --watch test/**/*.test.js",
    "build": "node scripts/build.js",
    "prepublishOnly": "npm run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import tsx/esm packages/server/src/db/migrate.ts",
    "db:seed": "node --import tsx/esm scripts/seed.ts"
  },
  "keywords": [
    "ssh",
    "mcp",
    "server",
    "cli",
    "devops",
    "ai-agent",
    "monorepo"
  ],
  "author": "Junki",
  "license": "ISC",
  "devDependencies": {
    "drizzle-kit": "^0.30.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.2"
  },
  "files": [
    "packages/server/dist/**/*",
    "packages/cli/dist/**/*",
    "web-dist/**/*"
  ]
}
