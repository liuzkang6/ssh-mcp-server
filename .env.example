# Docker 部署环境变量样例
# 复制为 .env 并填入真实值,然后 docker compose up -d

# 必填:AES-256-GCM 主密钥,32 字节 base64
# 生成: openssl rand -base64 32
ENCRYPTION_KEY=REPLACE_WITH_OPENSSL_RAND_BASE64_32

# 必填:JWT 签名密钥,任意长字符串
# 生成: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32

# 可选:HTTP 端口(默认 3000)
PORT=3000
