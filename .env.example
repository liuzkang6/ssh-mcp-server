# opsgate 环境变量样例
# ==========================
#
# 1. 复制为 .env:
#      cp .env.example .env
#
# 2. 填入下面标有 [REQUIRED] 的变量
#    标有 [OPTIONAL] 的可以不改,会用默认行为
#
# 3. 启动:
#      docker compose up -d
#    或本地:
#      node packages/server/dist/index.js --enable-web
#
# ============ 必填 [REQUIRED] ============

# AES-256-GCM 主加密密钥(用于加密所有 SSH 凭证,落库前必走一遍)
# 解码后必须 >= 32 字节,启动时会强校验
# 生成:openssl rand -base64 32
ENCRYPTION_KEY=REPLACE_WITH_OPENSSL_RAND_BASE64_32

# JWT 签名密钥(HS256,任意长字符串都行,推荐 64 字符 hex)
# 生成:openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32

# ============ 可选 [OPTIONAL] ============

# HTTP 监听端口(默认 3000)
PORT=3000

# 数据目录(SQLite DB + 上传/下载缓存)
DATA_DIR=./data

# 日志目录
LOG_DIR=./logs

# 日志级别:debug | info | warn | error
LOG_LEVEL=info

# Node 运行环境:development | production(影响错误消息详细程度)
NODE_ENV=production

# 关闭 MCP stdio 模式(默认开启,后台用可关)
# DISABLE_MCP=true

# 关闭 Web 静态文件服务(纯 API 模式,需自己挂载 web-dist)
# DISABLE_WEB=true
